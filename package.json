{
  "name": "ara-agency",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4173",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components/ara components/studio/redesigns components/studio/outreach components/studio/ProjectForm.tsx src/server src/posts.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "post:new": "node scripts/new-post.mjs",
    "test:studio:e2e": "node --experimental-strip-types scripts/test-studio.mjs",
    "test:redesigns:e2e": "node --experimental-strip-types scripts/test-redesigns.mjs",
    "test:outreach:e2e": "node --experimental-strip-types scripts/test-redesigns.mjs --outreach",
    "test:projects:e2e": "node --experimental-strip-types scripts/test-redesigns.mjs --projects",
    "dev:preview": "node scripts/studio-preview.mjs",
    "studio:doctor": "node scripts/studio-doctor.mjs"
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "motion": "12.43.0",
    "next": "16.4.3",
    "node-html-parser": "9.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
