# Actual public origin, without a trailing slash. Never guess a purchased domain.
NEXT_PUBLIC_SITE_URL=http://localhost:4173
# Keep previews excluded from search. Set true only for the public production site.
PUBLIC_INDEXING=false
# Local saves are explicitly labelled and work only in development on loopback.
LOCAL_FORM_MODE=false
# Server-only Supabase credentials. Apply the SQL migration first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Studio uses the publishable key with each staff member's access token, never the service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Exact browser origin used for Studio CSRF checks. Set the real HTTPS origin in production.
STUDIO_ORIGIN=http://127.0.0.1:4173
# Optional read-only sample preview. Enabled automatically by npm run dev:preview.
# Development and loopback requests only; ignored in production.
STUDIO_LOCAL_PREVIEW=false
# Generate a random server-only secret for hashing submission rate-limit keys.
RATE_LIMIT_SECRET=
# Cloudflare Turnstile: site key is public; secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend: verified sender and the actual agency notification address.
RESEND_API_KEY=
EMAIL_FROM=
AGENCY_NOTIFICATION_EMAIL=
# Optional analytics load only after consent. No enquiry fields are tracked.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
# Optional verified contact details. Leave empty until supplied.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
